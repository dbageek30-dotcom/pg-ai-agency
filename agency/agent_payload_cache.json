{
  "get data_directory path": {
    "type": "sql",
    "query": "SHOW data_directory;"
  },
  "show me the data_directory path": {
    "type": "sql",
    "query": "SHOW data_directory;"
  },
  "set max_connections to 150": {
    "type": "config",
    "target": "postgresql.conf",
    "line_to_add": "max_connections = 150"
  },
  "show max_connections value": {
    "type": "sql",
    "query": "SELECT name, setting FROM pg_settings WHERE name = 'max_connections';"
  },
  "set max_connections value to 150;": {
    "type": "config",
    "target": "postgresql.conf",
    "line_to_add": "max_connections = 150"
  },
  "get port value": {
    "type": "sql",
    "query": "SELECT name, setting FROM pg_settings WHERE name = 'port';"
  },
  "get 'port' parameter value": {
    "type": "sql",
    "query": "SELECT name, setting FROM pg_settings WHERE name = 'port';"
  },
  "give me the size of the data_directory folder in mb": {
    "type": "system",
    "command": "du",
    "arguments": [
      "-sh",
      "/var/lib/postgresql/18/data"
    ]
  },
  "give me the size of 'data_directory' in mb?": {
    "type": "system",
    "command": "du",
    "arguments": [
      "-sh",
      "/var/lib/postgresql/18/data"
    ]
  },
  "give me the value of shared_buffers": {
    "type": "sql",
    "query": "SHOW shared_buffers;"
  },
  "change the value of shared_buffers to 500mb": {
    "type": "config",
    "target": "/var/lib/postgresql/18/data/postgresql.conf",
    "line_to_add": "shared_buffers = 500MB"
  },
  "chang shared_buffers value to 500mb": {
    "type": "config",
    "target": "postgresql.conf",
    "line_to_add": "shared_buffers = 500MB"
  },
  "restart the cluster": {
    "type": "system",
    "command": "pg_ctl",
    "arguments": [
      "restart",
      "-D",
      "/var/lib/postgresql/18/data"
    ]
  },
  "set shared_buffers to 1gb": {
    "type": "config",
    "target": "postgresql.conf",
    "line_to_add": "shared_buffers = 1GB"
  },
  "restart the database cluster": {
    "type": "system",
    "command": "pg_ctl",
    "arguments": [
      "restart",
      "-D",
      "/var/lib/postgresql/18/data"
    ]
  },
  "is the database cluster started ?": {
    "type": "system",
    "command": "pg_ctl",
    "arguments": [
      "status",
      "-D",
      "/var/lib/postgresql/18/data"
    ]
  },
  "give me the free space of the filesystem of the database cluster": {
    "type": "system",
    "command": "df",
    "arguments": [
      "-h",
      "/var/lib/postgresql/18/data"
    ]
  },
  "create a new directory 'backup' on /var/lib/postgresql/18/backup": {
    "type": "system",
    "command": "mkdir",
    "arguments": [
      "-p",
      "/var/lib/postgresql/18/backup"
    ]
  }
}