{
  "show me the data_directory path": {
    "type": "sql",
    "query": "SHOW data_directory;"
  },
  "start database": {
    "type": "system",
    "command": "pg_ctl",
    "arguments": [
      "start",
      "-D",
      "/var/lib/postgresql/18/data"
    ]
  },
  "get database status": {
    "type": "system",
    "command": "pg_ctl",
    "arguments": [
      "status",
      "-D",
      "/var/lib/postgresql/18/data"
    ]
  },
  "give me database status": {
    "type": "system",
    "command": "psql",
    "arguments": [
      "-c",
      "SELECT pg_is_in_recovery(), pg_current_wal_lsn(), pg_last_xact_replay_timestamp();"
    ]
  },
  "give me database cluster status": {
    "type": "system",
    "command": "pg_ctl",
    "arguments": [
      "status",
      "-D",
      "/var/lib/postgresql/18/data"
    ]
  },
  "stop database cluster stop": {
    "type": "system",
    "command": "pg_ctl",
    "arguments": [
      "stop",
      "-D",
      "/var/lib/postgresql/18/data"
    ]
  },
  "start database cluster": {
    "type": "system",
    "command": "pg_ctl",
    "arguments": [
      "start",
      "-D",
      "/var/lib/postgresql/18/data"
    ]
  },
  "show me the current data_directory path": {
    "type": "sql",
    "query": "SHOW data_directory;"
  },
  "check the number of active connections on the cluster": {
    "type": "sql",
    "query": "SELECT count(*) FROM pg_stat_activity WHERE state != 'idle';"
  },
  "change the max_connections parameter to '150'": {
    "type": "config",
    "target": "postgresql.conf",
    "line_to_add": "max_connections = '150'"
  },
  "modify shared_buffers to '512mb'": {
    "type": "config",
    "target": "postgresql.conf",
    "line_to_add": "shared_buffers = '512MB'"
  },
  "check the disk space usage of the system": {
    "type": "system",
    "command": "df",
    "arguments": [
      "-h"
    ]
  },
  "get the size of the directory /var/lib/postgresql/18/data": {
    "type": "system",
    "command": "du",
    "arguments": [
      "-sh",
      "/var/lib/postgresql/18/data"
    ]
  },
  "add an invalid line to postgresql.conf with missing quotes": {
    "type": "config",
    "target": "postgresql.conf",
    "line_to_add": "invalid_parameter = value_without_quotes"
  },
  "open the pg_hba.conf file using vi to see the contents": {
    "type": "system",
    "command": "cat",
    "arguments": [
      "/var/lib/postgresql/18/data/pg_hba.conf"
    ]
  },
  "minimal required arguments for the initdb command to initialize a secure data directory with a custom superuser": {
    "type": "system",
    "command": "initdb",
    "arguments": [
      "-D",
      "/var/lib/postgresql/18/data",
      "-E",
      "UTF-8",
      "-W"
    ]
  },
  "safely start the postgresql server in the background using pg_ctl instead of direct postgres execution": {
    "type": "system",
    "command": "pg_ctl",
    "arguments": [
      "start",
      "-D",
      "/var/lib/postgresql/18/data",
      "-l",
      "/var/lib/postgresql/18/data/logfile",
      "-w"
    ]
  },
  "check which parameters in pg_settings have been modified from their default values": {
    "type": "sql",
    "query": "SELECT name, setting, boot_val, reset_val FROM pg_settings WHERE setting != boot_val;"
  },
  "configure pg_hba.conf to allow only local connections using unix domain sockets via trust authentication": {
    "type": "config",
    "target": "pg_hba.conf",
    "line_to_add": "local all all trust"
  },
  "grant read-only access to all current and future tables within a specific schema": {
    "type": "sql",
    "query": "GRANT USAGE ON SCHEMA schema_name TO role_name; GRANT SELECT ON ALL TABLES IN SCHEMA schema_name TO role_name;"
  },
  "prevent new connections to a specific database while preparing to drop it": {
    "type": "sql",
    "query": "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = 'specific_database_name' AND pid <> pg_backend_pid();"
  },
  "rename an existing active database without causing data corruption": {
    "type": "sql",
    "query": "ALTER DATABASE old_database_name RENAME TO new_database_name;"
  }
}